doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Arial', sans-serif;
      }

      body {
        background-color: #f4f7f9;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
      }

      .container {
        background-color: #ffffff;
        width: 90%;
        max-width: 600px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }

      .header {
        background-color: #4A90E2;
        color: #ffffff;
        text-align: center;
        padding: 20px;
      }

      .content {
        background-color: #ffffff;
        padding: 20px;
      }

      .content h2 {
        color: #333;
        margin-bottom: 10px;
      }

      .content ul {
        list-style-type: none;
      }

      .content li {
        background: #eef4ff;
        margin: 5px 0;
        padding: 10px;
        border-radius: 5px;
        transition: background 0.3s;
      }

      .content li:hover {
        background: #d0e0ff;
      }

      .footer {
        background-color: #333;
        color: #ffffff;
        text-align: center;
        padding: 15px;
        font-size: 0.9em;
      }
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Email enviado desde lomoToilet
  body
    .container
      .header
        h1 ⚠️​​Notificación de incidencia
        h2 El profesor #{nombreProfesor} ha reportado:
      .content
        #{contenido}
      .footer
        p
          | El mensaje se ha enviado a las: #{horaDia}hrs.
          br
          | Por favor no responda a este correo
          br
          | Si desea más información, por favor contacte con el profesor.